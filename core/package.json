    "Browser Extension",
    "Electron",
    "iframe",
    "webview",
    "React Native"
  ],
  "author": "molvqingtai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/molvqingtai/comctx.git"
  },
  "bugs": {
    "url": "https://github.com/molvqingtai/comctx/issues"
  },
  "homepage": "https://github.com/molvqingtai/comctx#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
